# Netlify cache headers for MergeMint
# HTML: always revalidate (pages change on every deploy; stale HTML
# previously served old JS to phones, breaking new features)
/*.html
  Cache-Control: public, max-age=0, must-revalidate
/
  Cache-Control: public, max-age=0, must-revalidate

# Static assets: cache longer (filenames are stable, updates are infrequent)
/assets/*
  Cache-Control: public, max-age=604800, immutable
/*.css
  Cache-Control: public, max-age=86400, must-revalidate
/*.js
  Cache-Control: public, max-age=86400, must-revalidate

# Sitemap & robots: revalidate often
/sitemap.xml
  Cache-Control: public, max-age=3600, must-revalidate
/robots.txt
  Cache-Control: public, max-age=3600, must-revalidate
